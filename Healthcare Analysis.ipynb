    "#Definiendo funciones\n",
    "\n",
    "def unir_consultas(ID, how, *args):\n",
    "    \"\"\"\n",
    "    Esta función permite unir 2 o más consultas en una sola, la cual es retornada para ser usada más adelante.\n",
    "\n",
    "    *args: Permmite mandar 2 o más consultas para unificarlas\n",
    "    ID: Especificar la columna que tienen en comun las consultas y por la cual se van a organizar\n",
    "    how: Especificar si es unión regular, izquierda, derecha o outter (Join de SQL)\n",
    "    \"\"\"\n",
    "    if (len(args) < 2):\n",
    "        raise ValueError(\"Por favor usar 2 o más DataFrames para usar esta función, cualquier duda, usar help(unir_consultas)\")\n",
    "\n",
    "    union = reduce(lambda left, right: pd.merge(left, right, on=ID, how=how), args)\n",
    "\n",
    "    return union\n",
    "\n",
    "\n",
    "def top_10(df, columna, valores, horizontal = False):\n",
    "    \"\"\"\n",
    "    Función que retorna el top 10 de un df en base una columna dada y al valor como referencia que se va a usar\n",
    "\n",
    "    df: Nombre del dataframe\n",
    "    Columna: el primer valor del groupby (la columna a usar como referencia)\n",
    "    Valores: La columna de donde se van a sumar, promediar o contar los valores\n",
    "    Horizontal: Permite saber si el top se usará para una gráfica horizontal\n",
    "    \"\"\"\n",
    "\n",
    "    top = df.groupby(columna).agg(Total=(valores, 'count'))\n",
    "    \n",
    "    # Ordenamos de mayor a menor para sacar el Top 10\n",
    "    top = top.sort_values(by='Total', ascending=False).head(10).reset_index()\n",
    "    \n",
    "    if horizontal == True:\n",
    "         # Invertimos el orden solo para la estética de la gráfica de barras horizontal\n",
    "        top = top.sort_values(by='Total', ascending=True).reset_index()\n",
    "   \n",
    "    return top\n",
    "\n",
    "def editar_grafica(df, tipo, titulo, x_col, y_col, xlabel_texto=None, ylabel_texto=None,millones=False):\n",
    "    \"\"\" \n",
    "    Función dinámica para generar y personalizar cualquier gráfica de Pandas.\n",
    "\n",
    "    df: DataFrame a utilizar\n",
    "    tipo: Tipo de gráfica ('scatter', 'barh', 'line', etc.)\n",
    "    titulo: Título de la gráfica\n",
    "    x_col: Nombre de la columna para el eje X\n",
    "    y_col: Nombre de la columna para el eje Y\n",
    "    xlabel_texto: Texto personalizado para el eje X (Opcional)\n",
    "    ylabel_texto: Texto personalizado para el eje Y (Opcional)\n",
    "    millones: En caso de que la gráfica involucre cifras grandes (millones) se agrega True al final de los parámetros para poder darles formato (Opcional)\n",
    "    \"\"\"\n",
    "\n",
    "    ax = df.plot(kind=tipo, x=x_col, y=y_col, legend=False)\n",
    "    \n",
    "    ax.set_title(titulo, fontsize=14, fontweight='bold', pad=15)\n",
    "    \n",
    "    ax.set_xlabel(xlabel_texto if xlabel_texto else x_col, fontsize=12) #Esto es por si no pasan valores de labels x y, ponga el mismo valor de col\n",
    "    ax.set_ylabel(ylabel_texto if ylabel_texto else y_col, fontsize=12)\n",
    "    if millones == True:\n",
    "        ax.yaxis.set_major_formatter(StrMethodFormatter('{x:,.0f}'))\n",
    "\n",
    "def editar_grafica_variable(variable, tipo, titulo, xlabel=None, ylabel=None, millones = False):\n",
    "    \"\"\" \n",
    "    Función creada para editar gráficas usando una variable en lugar de un DF completo\n",
    "\n",
    "    variable: Nombre de la variable a usar\n",
    "    tipo: Tipo de gráfica ('scatter', 'barh', 'line', etc.)\n",
    "    xlabel_texto: Texto personalizado para el eje X\n",
    "    ylabel_texto: Texto personalizado para el eje Y\n",
    "    millones: En caso de que la gráfica involucre cifras grandes (millones) se agrega True al final de los parámetros para poder darles formato (Opcional)\n",
    "    \"\"\"\n",
    "    if tipo == \"pie\":\n",
    "        ax = variable.plot(kind = tipo, autopct='%1.1f%%', startangle=140)\n",
    "        ax.set_title(titulo, fontsize=14, fontweight='bold', pad=15)\n",
    "        ax.set_ylabel(\"\")\n",
    "    else:\n",
    "        ax = variable.plot(kind=tipo, legend = False)\n",
    "        ax.set_title(titulo, fontsize=14, fontweight='bold', pad=15)    \n",
    "        ax.set_xlabel(xlabel, fontsize=12)\n",
    "        ax.set_ylabel(ylabel, fontsize=12)\n",
    "    \n",
    "    if millones == True:\n",
    "        ax.yaxis.set_major_formatter(StrMethodFormatter('{x:,.0f}'))\n",
    "    "
   ]

    "6.- Diccionario de variables"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f859af29-f435-4f39-b68e-0c5cb973757d",
   "metadata": {},
   "source": [
    "* consultas = CSV de Consultas |\n",
    "* diagnosticos = CSV de Diagnosticos |\n",
    "* receta_medica = CSV de Recetas Médicas |\n",
    "* pacientes = CSV de Pacientes |\n",
    "* treatment_cost_average = Costo promedio de tratamiento |\n",
    "* unit_price_average = Promedio de unidades de medicamento |\n",
    "* engine = Motor para base de datos |\n",
    "* tablas = Lista con los nombres de las tablas |\n",
    "* mujeres = Lista con diccionarios de pacientes del sexo femenino |\n",
    "* query = Query usado para obtener las columnas \"Consultation_ID\", \"Diagnosis\" y \"Treatment_Cost\" de la tabla \"Diagnósticos\" |\n",
    "* costo_tratamiento = DF unido de las tablas \"Consultas\" (Tabla completa) y \"Diagnósticos\" (solo las columnas \"Consultation_ID\", \"Diagnosis\" y \"Treatment_Cost\") |\n",
    "* costo = Agrupamiento, tomando costo_tratamiento comobase, se agrupa por \"Specialty\" tomando los valores de \"Tratment_Cost\"en suma, ordenados de mayor a menor |\n",
    "* grafico_costo = Variale costo convertida en gráfica |\n",
    "* mainDF = DF Principal, uniendo el DF costo_tratamiento y la tabla \"Recetas_Medicas\" (completa) |\n",
    "* diagnosis = Top 10 de diagnósticos |\n",
    "* query_clasification = Query para obtener las columnas \"Patient_ID\", \"Age\", \"Gender\" y \"Clasificacion\" de la tabla \"Pacientes\"\n",
    "* clasificacion = DF unido entre costo_tratamiento y la tabla Pacientes con las columnas obtenidas con el query anterior\n",
    "* enfermedades = Pivot Table del DF clasificacion donde se cuentan valores de las columnas mostradas, \n",
    "    index = diagnóstico, columns = Clasificacion |\n",
    "* grafica_enfermedades = Variable enfermedades convertida en gráfica |\n",
    "* espera_promedio_diagnostico = Tiempo promedio de espera por diagnóstico |\n",
    "* espera_promedio_clasificacion = Tiempo promedio de espera por grupo de edad |\n",
    "* espera_promedio_especialidad = Tiempo promedio de espera por especialidad |\n",
    "* costo_promedio_diagnostico = Costo promedio de tratamiento por diagnóstico |\n",
    "* costo_especialidad = Costo total de tratamiento por especialidad |\n",
    "* costo_grupo_edad = Costo total de tratamiento por grupo de edad |\n",
    "* top_10_pacientes = Top 10 de pacientes más recurrentes |\n",
    "* pacientes_multidiagnostico = Pivot table donde se muestra en total cuantos diagnósticos tiene cada paciente,\n",
    "    index = Patient_ID, columns = Diagnosis, values = Consultation_ID |\n",
    "* medicamentos_usados = Total de medicamentos usados, Agrupamiento de mainDF en base a Medication y la suma de Quantity |\n",
    "* costo_medicamento = Agrupamento de mainDF, usado para sacar el costo de tratamiento usado por cada medicamento |\n",
    "* tiempo_espera_diagnostico = Promedio del tiempo de esperaen acorde al diagnóstico |\n",
    "* edad_costo = Costo promedio de tratamiento en base al grupo de edad |\n",
    "* edad_tiempo_espera = Tiempo promedio de espera en base al grupo de edad |"
   ]

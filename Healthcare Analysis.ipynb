   "source": [
    "#Migrando la información a SQLite\n",
    "\n",
    "engine = create_engine(\"sqlite:///Base_Hospital2.db\")\n",
    "\n",
    "dataframes = [consultas, diagnosticos, receta_medica, pacientes]\n",
    "tablas = [\"Consultas\", \"Diagnosticos\", \"Recetas_Medicas\", \"Pacientes\"]\n",
    "\n",
    "for df, nombre_tabla in zip(dataframes, tablas):\n",
    "    df.to_sql(\n",
    "        name = nombre_tabla,\n",
    "        con = engine,\n",
    "        if_exists = \"append\", #Aquí podemos cambiar por replace o fail, dependiendo que querramos hacer, en este caso se agregan al final si existe\n",
    "        index = False, #Si se usa False, no se guarda el indice de pandas en la tabla, que es lo ideal\n",
    "        chunksize = 10000, #Tamaño de los bloques que se van a insertar, en este caso es de 10k en 10k\n",
    "        method = \"multi\" #Esto permite insertar más de fila en una sentencia insert\n",
    "    )\n",
    "\n",
    "print(\"La información se ha migrado exitosamente\")"
   ]
